<nav class="main-navigation">
  <div class="nav-container">
    <div class="nav-brand">
      <%= link_to "Flexbase", root_path, class: "brand-link" %>
    </div>

    <div class="nav-menu">
      <% if authenticated? %>
        <span class="nav-user">
          <%= Current.session.user.email_address %>
        </span>
        <%= button_to "Logout", session_path, method: :delete, class: "nav-link" %>
      <% else %>
        <%= link_to "Login", new_session_path, class: "nav-link" %>
      <% end %>
    </div>
  </div>
</nav>
